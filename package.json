{
  "name": "@edgeproc/privacy-core",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "A TypeScript library that hides card numbers, emails and ID numbers from AI models, then puts them back in the reply.",
  "keywords": [
    "pii",
    "pii-redaction",
    "pii-detection",
    "privacy",
    "data-masking",
    "llm",
    "llm-security",
    "prompt-privacy",
    "egress-control",
    "luhn",
    "iban",
    "browser",
    "client-side",
    "typescript",
    "gdpr"
  ],
  "license": "MIT",
  "author": "Harish Seshadri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseshadr/privacy-core.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@edgeproc/avow": "^0.4.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/demo/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "pnpm --filter @edgeproc/privacy-core-demo dev",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
